<Window x:Class="Homework.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Кредитный калькулятор" Width="460" Height="430" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI" FontSize="15">
    <StackPanel Margin="25">
        <TextBlock Text="Расчёт кредита" FontSize="24" Margin="0,0,0,20" />
        <TextBlock Text="Сумма кредита, руб." />
        <TextBox x:Name="AmountBox" Text="100000" Margin="0,5,0,12" />
        <TextBlock Text="Процентная ставка в год, %" />
        <TextBox x:Name="RateBox" Text="12" Margin="0,5,0,12" />
        <TextBlock Text="Срок кредита, месяцев" />
        <TextBox x:Name="MonthsBox" Text="12" Margin="0,5,0,15" />
        <Button Content="Рассчитать" Click="Calculate_Click" Height="36" />
        <TextBlock x:Name="ResultBlock" Margin="0,15,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>