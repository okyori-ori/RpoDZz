<Window x:Class="Homework.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Заметки" Width="780" Height="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI" FontSize="15">
    <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <ListBox x:Name="NotesList" SelectionChanged="NotesList_SelectionChanged" />
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="35" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Заголовок" />
            <TextBox x:Name="TitleBox" Grid.Row="1" Margin="0,3,0,5" />
            <TextBlock Grid.Row="2" Text="Содержание" Margin="0,8,0,5" />
            <TextBox x:Name="ContentBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="DateBlock" Grid.Row="4" Text="Дата создания:" Margin="0,15,0,10" />
            <WrapPanel Grid.Row="5"><Button Content="Добавить" Click="Add_Click" Padding="10,6" Margin="0,0,5,8" Background="LightGreen" /><Button Content="Сохранить" Click="Save_Click" Padding="10,6" Margin="0,0,5,8" Background="LightBlue" /><Button Content="Удалить" Click="Delete_Click" Padding="10,6" Margin="0,0,5,8" Background="LightSalmon" /><Button Content="Очистить поля" Click="Clear_Click" Padding="10,6" Margin="0,0,0,8" /></WrapPanel>
        </Grid>
    </Grid>
</Window>