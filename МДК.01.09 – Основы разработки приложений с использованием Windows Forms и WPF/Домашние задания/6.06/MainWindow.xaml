<Window x:Class="Homework.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Площади фигур" Width="430" Height="390" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI" FontSize="15">
    <StackPanel Margin="25"><TextBlock Text="Площадь фигуры" FontSize="24" Margin="0,0,0,15" />
        <ComboBox x:Name="ShapeBox" SelectedIndex="0" SelectionChanged="Shape_Changed" Margin="0,0,0,15"><ComboBoxItem Content="Прямоугольник" /><ComboBoxItem Content="Квадрат" /><ComboBoxItem Content="Круг" /><ComboBoxItem Content="Треугольник" /></ComboBox>
        <TextBlock x:Name="FirstLabel" Text="Ширина" /><TextBox x:Name="FirstBox" Margin="0,5,0,12" />
        <TextBlock x:Name="SecondLabel" Text="Высота" /><TextBox x:Name="SecondBox" Margin="0,5,0,15" />
        <Button Content="Рассчитать" Click="Calculate_Click" Height="35" /><TextBlock x:Name="ResultBlock" Margin="0,15,0,0" />
    </StackPanel>
</Window>