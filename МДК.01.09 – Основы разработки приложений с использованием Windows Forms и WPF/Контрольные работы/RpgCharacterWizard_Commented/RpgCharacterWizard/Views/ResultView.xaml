<UserControl x:Class="RpgCharacterWizard.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Карточка персонажа" Style="{StaticResource SectionTitle}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Берём тот же аватар, который показывали на шаге выбора класса. -->
            <Image Source="{Binding AvatarPath}" Width="176" Height="176"/>
            <!-- Подставляем выбранные расу, класс и характеристики из модели. -->
            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedRace.Name, StringFormat='Раса: {0}'}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedClass.Name, StringFormat='Класс: {0}'}"
                           FontWeight="SemiBold" Margin="0,4,0,14"/>
                <TextBlock Text="{Binding Strength, StringFormat='Сила: {0}'}"/>
                <TextBlock Text="{Binding Agility, StringFormat='Ловкость: {0}'}" Margin="0,4"/>
                <TextBlock Text="{Binding Intelligence, StringFormat='Интеллект: {0}'}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
